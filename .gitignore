# Shard output. Test-Shard.ps1 works in $env:TEMP, but a manual pack run is
# usually aimed at the folder you happen to be standing in, and a few thousand
# .shard zips committed once is a repo nobody wants to clone.
*.shard*.zip
*.manifest.zip
*.manifest.zip.[0-9][0-9][0-9]
manifest.json

# IDE / editor state
.vs/
.idea/
.vscode/
*.user
*.suo

# OS noise
Thumbs.db
.DS_Store
